# =============================================================================
# OpenMRS Trust Bot — Environment Variables
#
# Copy this file to .env and fill in real values. Never commit .env.
# See openspec/specs/config-schema.md "Environment Variables Reference" for
# full descriptions.
# =============================================================================

# --- Discourse ---
# Shared secret used to verify the Discourse Workflow's HTTP action
# requests (HMAC-SHA256 signature in the X-Discourse-Workflow-Secret
# header, computed by a Code step inside the Workflow using this same
# secret as its key). Any workflow name is accepted — which workflow
# maps to which action is declared in rules.yaml (type: workflow
# triggers), not here.
DISCOURSE_WORKFLOW_SECRET=

# Shared secret used to verify native Discourse webhook requests
# (HMAC-SHA256 signature in the X-Discourse-Event-Signature header, set
# when creating the webhook in Discourse's admin UI). Which event types
# map to which action is declared in rules.yaml (type: webhook triggers).
DISCOURSE_WEBHOOK_SECRET=

# Discourse API key for read access (used by /trust-status).
DISCOURSE_API_KEY=

# Discourse username associated with the API key above.
DISCOURSE_API_USERNAME=

# --- Keycloak ---
# Client ID for the Trust Bot service account in Keycloak.
KEYCLOAK_CLIENT_ID=

# Client secret for the Trust Bot service account.
KEYCLOAK_CLIENT_SECRET=

# --- Slack ---
# Slack Bot OAuth token (xoxb-...).
SLACK_BOT_TOKEN=

# Slack signing secret, used to verify incoming Slack requests.
SLACK_SIGNING_SECRET=

# --- Admin API ---
# Bearer token required to call the admin API endpoints (e.g. runtime log
# level changes).
ADMIN_API_TOKEN=

# --- Optional overrides ---
# Overrides logging.level in config.yaml (DEBUG | INFO | WARNING | ERROR).
LOG_LEVEL=

# Overrides dry_run in config.yaml (true | false). Blank falls back to
# config.yaml's value.
DRY_RUN=

# Path to config.yaml. Defaults to /config/config.yaml (the container mount
# path); override for local, non-Docker development, e.g. ./config/config.yaml
CONFIG_PATH=

# Path to rules.yaml. Defaults to /config/rules.yaml (the container mount
# path); override for local, non-Docker development, e.g. ./config/rules.yaml
RULES_PATH=
