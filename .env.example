# =============================================================================
# OpenMRS Trust Bot — Environment Variables
#
# Copy this file to .env and fill in real values. Never commit .env.
# See openspec/specs/config-schema.md "Environment Variables Reference" for
# full descriptions.
# =============================================================================

# --- Discourse ---
# Shared secret used to verify Discourse webhook signatures.
DISCOURSE_WEBHOOK_SECRET=

# Discourse API key for read access (used by /trust-status).
DISCOURSE_API_KEY=

# Discourse username associated with the API key above.
DISCOURSE_API_USERNAME=

# --- Keycloak ---
# Client ID for the Trust Bot service account in Keycloak.
KEYCLOAK_CLIENT_ID=

# Client secret for the Trust Bot service account.
KEYCLOAK_CLIENT_SECRET=

# --- Slack ---
# Slack Bot OAuth token (xoxb-...).
SLACK_BOT_TOKEN=

# Slack signing secret, used to verify incoming Slack requests.
SLACK_SIGNING_SECRET=

# --- Admin API ---
# Bearer token required to call the admin API endpoints (e.g. runtime log
# level changes).
ADMIN_API_TOKEN=

# --- Optional overrides ---
# Overrides logging.level in config.yaml (DEBUG | INFO | WARNING | ERROR).
LOG_LEVEL=

# Overrides discourse.webhook.replay_window_seconds in config.yaml (seconds).
DISCOURSE_REPLAY_WINDOW_SECONDS=
